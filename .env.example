# ============================================================================
# Westpeak Wellness — environment
#
# Copy to .env.local for development. In production these are set in Vercel
# (Project → Settings → Environment Variables). Changing any of them requires
# a redeploy to take effect; the client list in /admin does NOT, which is the
# point of storing it in Blob instead of here.
# ============================================================================

# --- Site -------------------------------------------------------------------
# Canonical origin. Drives canonicals, OG absolute URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.westpeakwellness.com

# --- Booking (Cliniko) ------------------------------------------------------
# The practice's online-bookings URL, embedded on /book and /client-portal.
# Looks like https://<practice>.cliniko.com/bookings
# Until this is set, both pages explain the process and route to email rather
# than embedding a calendar that is not there.
NEXT_PUBLIC_CLINIKO_URL=

# Optional: lets Cliniko patients sign in without being added to the client
# list. Must include the shard suffix (…-au1, …-ca1) — the API host is derived
# from it. Additive only: if it fails, listed clients still get in.
CLINIKO_API_KEY=

# --- Authentication ---------------------------------------------------------
# Required. Signs session tokens. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google sign-in. Create an OAuth client at console.cloud.google.com
# (APIs & Services → Credentials → OAuth client ID → Web application) and set
# the authorised redirect URI to:
#   https://<your-domain>/api/auth/callback/google
# While these are unset the Google button is hidden and password sign-in works.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Who may reach /admin. Comma-separated. Deliberately NOT editable from /admin:
# the screen that manages clients must not be able to remove the last way in.
PORTAL_ADMIN_EMAILS=

# Signs password-reset links. Generate with: openssl rand -base64 32
PORTAL_SECRET=

# --- Transactional email ----------------------------------------------------
# Sends the password-reset links from /forgot. Without these the form still
# accepts an address and still confirms, and no mail is sent — so reset is
# effectively unavailable until they are set.
# Create a key at resend.com and verify the sending domain first.
RESEND_API_KEY=
PORTAL_FROM_EMAIL=

# Legacy client list, merged with the one managed in /admin. Prefer /admin.
PORTAL_ALLOWED_EMAILS=

# --- Monthly revenue report -------------------------------------------------
# Emails a per-practitioner revenue summary for the previous calendar month, on
# the 1st at 15:00 UTC (08:00 Vancouver in summer, 07:00 in winter). Scheduled
# in vercel.json; the route is /api/cron/revenue-report.
#
# REQUIRED — the route refuses to run without it. Vercel Cron sends it
# automatically as `Authorization: Bearer $CRON_SECRET` once it is set here.
# An unset secret is treated as misconfiguration, NOT as "no auth needed":
# otherwise the practice's monthly income would sit at a guessable URL.
#   Generate with: openssl rand -base64 32
CRON_SECRET=

# Who receives it. Comma-separated. Defaults to info@westpeakwellness.com.
REVENUE_REPORT_TO=

# The report also needs CLINIKO_API_KEY (above) and RESEND_API_KEY +
# PORTAL_FROM_EMAIL (above). Without Cliniko it returns 503; without Resend,
# 502 — in both cases loudly, never a silent no-op.

# --- Storage ----------------------------------------------------------------
# Set automatically when the Vercel Blob store is linked to the project.
# Holds the client allowlist and any password hashes.
BLOB_READ_WRITE_TOKEN=

# --- Analytics & verification ----------------------------------------------
# GA4 measurement ID (G-XXXXXXXXXX). Unset = no analytics loaded at all.
NEXT_PUBLIC_GA_ID=

# Search Console / Bing ownership tokens. Unset = no verification tag emitted.
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=

# --- Entity & reviews -------------------------------------------------------
# Profiles that let a search engine confirm this is one real practice. Emitted
# as schema `sameAs` only when set, so nothing points at a listing that does
# not exist yet.
NEXT_PUBLIC_PSYCHOLOGY_TODAY_URL=
NEXT_PUBLIC_BCACC_PROFILE_URL=
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=

# Google review link, shown on /reviews to people who have already decided to
# leave one. Publishing it is fine; SENDING it to a client is solicitation and
# BCACC prohibits that — see REVIEW_REQUEST.md.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# --- Lead capture -----------------------------------------------------------
# Where the lead-magnet form POSTs (Formspree, Basin, a Zapier hook…).
# Unset = the form still works and still confirms, and the submission is logged
# as an analytics event so no interest is silently lost.
NEXT_PUBLIC_FORM_ENDPOINT=
